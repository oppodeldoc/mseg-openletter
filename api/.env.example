# Production shape — the container reads these from the runtime environment
# (docker-compose env_file). Locally, copy to .env and point DATABASE_URL at a dev Postgres.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
# openssl rand -hex 16 — changing it invalidates every signature/edit token
APP_KEY=
APP_NAME=mseg-signon
# no ?ssl=true needed on the docker network; for a remote DB, ?ssl=true must be the FIRST query param
DATABASE_URL=postgres://openletter:<pw>@postgres:5432/openletter
# Public frontend (Vercel) — used in email links
WEBSITE_URL=https://sign.ousd-mseg.org
PRIVACY_URL=https://ousd-mseg.org/pages/privacy
# Comma-separated browser origins allowed to call the API (scheme + host, no trailing slash)
CORS_ORIGINS=https://sign.ousd-mseg.org
# Set to true only while creating/editing the statement, then back to false
ALLOW_LETTER_CREATE=false
# Postmark SMTP: server token is both username and password
MAIL_CONNECTION=smtp
SMTP_HOST=smtp.postmarkapp.com
SMTP_PORT=587
MAIL_USERNAME=<postmark server token>
MAIL_PASSWORD=<postmark server token>
MAIL_FROM="OUSD MSEG <engage@ousd-mseg.org>"
POSTMARK_STREAM=outbound
SESSION_DRIVER=cookie
HASH_DRIVER=bcrypt
CACHE_VIEWS=true
